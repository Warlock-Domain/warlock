{
  "name": "warlock",
  "main": "src/worker/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "FORUM", "class_name": "Forum" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Forum"] }
  ],
  "routes": [{ "pattern": "warlock.fernandorffdev.com", "custom_domain": true }]
}
